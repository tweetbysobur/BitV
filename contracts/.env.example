# BitV contracts — deployment environment variable template.
# Copy to contracts/.env for local use with `forge script --env-file .env`
# (or export these directly in your shell). NEVER commit a real .env file
# or a real private key anywhere in this repository.
#
# These are DEPLOYMENT-time variables, consumed by contracts/script/*.sol
# via `vm.envAddress`/`vm.envString`/etc. — distinct from the frontend's
# NEXT_PUBLIC_*-prefixed variables in the repo root's .env.example, which
# are consumed by the browser at runtime. A contract address that exists
# in both places (e.g. the Cleanverse validator) must be kept in sync
# manually — there is no code sharing between the two right now.

# ── Network ──────────────────────────────────────────────────────────────
# Monad Testnet RPC endpoint used by forge for broadcasting/reading.
# Chain ID 10143 — see docs/architecture.md for the verified value and
# its sourcing caveat. Do not point this at any other network without
# updating docs/architecture.md's confirmation first.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# ── Deployer signing ─────────────────────────────────────────────────────
# NEVER put a real private key in this file, in any committed file, or in
# shell history you don't control. Prefer `cast wallet import` and
# `forge script ... --account <name>`, or a hardware wallet
# (`--ledger`/`--trezor`), over a raw PRIVATE_KEY env var wherever
# possible. If a raw key must be used (e.g. a disposable testnet-only
# key in a CI secret store), it belongs in your shell/CI secrets
# manager — never in a file tracked by git, and never reused from any
# account holding real value. See docs/admin-key-strategy.md.
PRIVATE_KEY=
# The address the above key corresponds to — used by ValidateDeployment
# and for readable deployment records. Public data, but left out of any
# committed file the same as PRIVATE_KEY, purely to keep the two
# variables paired together operationally.
DEPLOYER_ADDRESS=

# ── Cleanverse (external, BLOCKED as of Build 10 — see
# docs/cleanverse-dependency-lock.md) ───────────────────────────────────
# Cleanverse's IAPassComplianceValidator deployment address. Deploy.s.sol
# reverts if this is unset or zero — there is no fallback. Do NOT fill
# this with a guessed/placeholder address; leave empty until Cleanverse
# confirms a real address for Monad Testnet.
CLEANVERSE_VALIDATOR_ADDRESS=
# Off-chain Cleanverse API credentials — exact variable names/format are
# BitV-side placeholders pending Cleanverse confirmation (see
# docs/cleanverse-integration-todo.md). Not consumed by any Solidity
# script; listed here because they gate the off-chain half of
# deployment (registering a deployed contract with Cleanverse).
CLEANVERSE_API_KEY=
CLEANVERSE_API_BASE_URL=

# ── Optional: yield vault deployment (Deploy.s.sol skips vault
# deployment entirely if YIELD_VAULT_ASSET is unset) ────────────────────
YIELD_VAULT_ASSET=
YIELD_VAULT_NAME=
YIELD_VAULT_SYMBOL=

# ── Post-deployment validation (ValidateDeployment.s.sol) ───────────────
# Fill these in only after a real deployment exists — see
# docs/deployment-readiness.md's "Deployment validation plan".
EXPECTED_CHAIN_ID=10143
EXPECTED_ADMIN_ADDRESS=
ACCESS_MANAGER_ADDRESS=
TREASURY_ADDRESS=
POOL_MANAGER_ADDRESS=
LENDING_MANAGER_ADDRESS=
BITSCORE_MANAGER_ADDRESS=
RWA_REGISTRY_ADDRESS=
CVA_ADAPTER_ADDRESS=
