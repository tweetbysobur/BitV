# BitV — environment variable template.
# Copy to .env.local for local dev. Never commit real secrets.
#
# Anything prefixed NEXT_PUBLIC_ is bundled into client-side JS and is
# PUBLIC — never put a real credential behind that prefix. Everything else
# here is server-only and must stay off the client.

# ── Public frontend variables (safe to expose to the browser) ──────────────
# WalletConnect / RainbowKit project ID — public by design, required for
# the wallet-connect UI to function.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Blockchain configuration (public) ───────────────────────────────────────
# Monad Testnet RPC endpoint used by the Web3 client. Intentionally not
# hardcoded in code (config/chains.ts) — the public default below is
# rate-limited; use your own RPC provider for anything beyond local dev.
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Cleanverse IAPassComplianceValidator deployment address on Monad Testnet.
# This is a contract address (public data), not a credential — safe as
# NEXT_PUBLIC_. UNCONFIRMED: do not fill with a guessed address; leave
# empty until Cleanverse's real deployment address is confirmed. See
# docs/cleanverse-integration.md.
NEXT_PUBLIC_CLEANVERSE_VALIDATOR_ADDRESS=

# ── Cleanverse credentials (PRIVATE — server-only, no NEXT_PUBLIC_ prefix) ──
# Exact variable names are BitV-side placeholders pending confirmation
# against Cleanverse's official docs — see
# /docs/cleanverse-integration-todo.md. Do not fill in until confirmed.
CLEANVERSE_API_KEY=
CLEANVERSE_API_BASE_URL=
