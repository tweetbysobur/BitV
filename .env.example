# BitV — environment variable template.
# Copy to .env.local for local dev. Never commit real secrets.

# Monad Testnet RPC endpoint used by the Web3 client.
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# WalletConnect / RainbowKit project ID (public — required for wallet connect UI).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cleanverse — exact variable names pending doc review, see
# /docs/cleanverse-integration-todo.md. Do not fill until confirmed against
# Cleanverse's official documentation.
CLEANVERSE_API_KEY=
CLEANVERSE_API_BASE_URL=
